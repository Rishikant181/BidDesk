MONGODB_URI=
MONGODB_DB=biddesk
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Gemini is optional; all manual workflows work without this key.
GEMINI_API_KEY=
GEMINI_GENERATION_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
BIDDESK_AI_ENABLED=true
BIDDESK_AI_DATA_MODE=public-demo
BIDDESK_AI_GENERATION_CALLS_PER_DAY=30
BIDDESK_AI_EMBEDDING_ITEMS_PER_DAY=200

# Private original PDFs; defaults to .local/documents, isolated by database name.
# BIDDESK_FILE_ROOT=/absolute/private/document-directory

# Monitoring: npm run monitor (one pass), npm run monitor -- --watch (continuous).
# Source checks run at most hourly per watched tender, with bounded retry backoff.
# Delivery defaults to private local files; no real email is sent in sink mode.
BIDDESK_MAIL_MODE=sink
# BIDDESK_MAIL_SINK=/absolute/private/mail-directory
# Set smtp only when you intend to deliver configured reminders to account emails.
# BIDDESK_SMTP_HOST=smtp.example.com
# BIDDESK_SMTP_PORT=587
# BIDDESK_SMTP_USER=
# BIDDESK_SMTP_PASSWORD=
# BIDDESK_MAIL_FROM=BidDesk <bids@example.com>
