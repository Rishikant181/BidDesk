{
  "manifest_version": 3,
  "name": "BidDesk attachment bridge",
  "version": "0.2.0",
  "description": "Explicitly transfer your source portal attachments to a paired local BidDesk workspace.",
  "permissions": [
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "https://tenderhut.in/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "minimum_chrome_version": "120"
}
