{
  "manifest_version": 3,
  "name": "BidDesk attachment bridge",
  "version": "0.3.0",
  "description": "Transfer your TenderHut attachments to a paired BidDesk workspace.",
  "permissions": [
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "https://tenderhut.in/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "minimum_chrome_version": "120",
  "optional_host_permissions": [
    "https://*/*"
  ]
}
